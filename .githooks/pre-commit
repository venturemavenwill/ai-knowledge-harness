#!/usr/bin/env sh
# Opt-in gate: refuses commits whose staged text carries hidden or smuggled
# Unicode characters. Disabled unless explicitly enabled, because rejecting a
# commit is the operator's decision, not the harness's default.
#
#   git config aikb.sanitizeHook true     # enable in this repository
#   git config --global aikb.sanitizeHook true
#   git config --unset aikb.sanitizeHook  # disable again
set -eu

if [ "$(git config --bool aikb.sanitizeHook 2>/dev/null || printf 'false')" != "true" ]; then
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
SANITIZER="$REPO_ROOT/scripts/strip_hidden_chars.py"

if [ ! -f "$SANITIZER" ]; then
  SANITIZER="${AI_KB_REPO:-}/scripts/strip_hidden_chars.py"
fi

if [ ! -f "$SANITIZER" ]; then
  printf '%s\n' 'BLOCKED  aikb.sanitizeHook is enabled but the sanitizer was not found.' >&2
  printf '%s\n' '         Set AI_KB_REPO to the harness checkout, or unset aikb.sanitizeHook.' >&2
  exit 2
fi

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v py >/dev/null 2>&1; then
  PYTHON='py -3'
else
  printf '%s\n' 'BLOCKED  Python 3.9 or newer must be on PATH to run the sanitize gate.' >&2
  exit 2
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

# Collect into positional parameters so filenames containing spaces survive, and
# check them in one invocation so the report is a single summary.
set --
while IFS= read -r FILE; do
  [ -n "$FILE" ] || continue
  [ -f "$FILE" ] || continue
  set -- "$@" "$FILE"
done <<STAGED_FILES
$STAGED
STAGED_FILES

[ "$#" -gt 0 ] || exit 0

STATUS=0
# Findings go to stderr and the clean report to stdout, so discarding stdout
# leaves only what the operator needs to see.
# shellcheck disable=SC2086
$PYTHON "$SANITIZER" "$@" >/dev/null || STATUS=1

if [ "$STATUS" -ne 0 ]; then
  printf '%s\n' 'BLOCKED  staged content contains hidden characters.' >&2
  printf '%s\n' '         Review them, then clean with:' >&2
  printf '%s\n' '           aikb sanitize <path> --write && git add <path>' >&2
  printf '%s\n' '         Bypass once with: git commit --no-verify' >&2
  exit 1
fi
